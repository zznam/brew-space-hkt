{
  "name": "vibing-hkt",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:web": "expo export --platform web",
    "format": "prettier --write app src tests e2e *.json *.ts *.mts *.js README.md CONTRIBUTING.md docs/core.md",
    "format:check": "prettier --check app src tests e2e *.json *.ts *.mts *.js README.md CONTRIBUTING.md docs/core.md",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "expo": "~58.0.25",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "zustand": "^5.0.0",
    "expo-router": "~58.0.31",
    "react-dom": "19.3.0",
    "react-native-web": "~0.21.4",
    "react-native-screens": "~4.30.1",
    "react-native-safe-area-context": "~5.11.1",
    "expo-linking": "~58.0.17",
    "expo-constants": "~58.0.16",
    "@react-native-async-storage/async-storage": "2.2.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.10.1",
    "@playwright/test": "^1.58.0"
  }
}
